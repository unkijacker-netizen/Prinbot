import telebot
from telebot.types import ReplyKeyboardMarkup, KeyboardButton
import os

TOKEN = os.getenv('BOT_TOKEN', 'សូមដាក់_TOKEN_របស់អ្នកនៅទីនេះ')
bot = telebot.TeleBot(TOKEN)

@bot.message_handler(commands=['start'])
def send_welcome(message):
    # ប្រើ ReplyKeyboardMarkup ដើម្បីឱ្យប៊ូតុងនៅខាងក្រោម ហើយ resize_keyboard=True ឱ្យប៊ូតុងតូចល្មម
    markup = ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    
    btn1 = KeyboardButton("👨🏻‍💻 គណនី")
    btn2 = KeyboardButton("🛍️ ហាងសេវា")
    btn3 = KeyboardButton("💸 ដាក់ប្រាក់")
    btn4 = KeyboardButton("💬 អ្នកគ្រប់គ្រង")
    
    markup.add(btn1, btn2, btn3, btn4)
    
    text = (
        "សួរស្ដី! សូមស្វាគមន៌មកកាន់ Toad Store 24/7\n"
        "សូមជ្រើសរើសសេវាកម្មខាងក្រោម"
    )
    bot.send_message(message.chat.id, text, reply_markup=markup)

# ចាប់យកសារនៅពេលគេចុចលើប៊ូតុង (ដោយសារវាជា Reply Keyboard វានឹងផ្ញើជាអក្សរ)
@bot.message_handler(func=lambda message: True)
def handle_text(message):
    if message.text == "🛍️ ហាងសេវា":
        bot.send_message(message.chat.id, "ប្រព័ន្ធកំពុង Update service .")
    elif message.text == "👨🏻‍💻 គណនី":
        bot.send_message(message.chat.id, "កំពុងរៀបចំ...")
    elif message.text == "💸 ដាក់ប្រាក់":
        bot.send_message(message.chat.id, "កំពុងរៀបចំ...")
    elif message.text == "💬 អ្នកគ្រប់គ្រង":
        # ផ្ញើ Username ដោយសារ Reply Keyboard មិនអាចដាក់ Link បាន
        bot.send_message(message.chat.id, "ទាក់ទងអ្នកគ្រប់គ្រងទីនេះ៖ @Dumyy_ji2")

print("Bot កំពុងដំណើរការ...")
bot.infinity_polling()
