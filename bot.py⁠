user_langs = {}

@bot.message_handler(commands=['start'])
def send_welcome(message):
    lang_markup = InlineKeyboardMarkup()
    btn_kh = InlineKeyboardButton("🇰🇭 ខ្មែរ", callback_data='lang_kh')
    btn_en = InlineKeyboardButton("🇬🇧 English", callback_data='lang_en')
    lang_markup.add(btn_kh, btn_en)
    
    text = "សូមជ្រើសរើសភាសា / Please choose your language:"
    bot.send_message(message.chat.id, text, reply_markup=lang_markup)

@bot.callback_query_handler(func=lambda call: call.data.startswith('lang_'))
def set_language(call):
    chat_id = call.message.chat.id
    
    if call.data == 'lang_en':
        user_langs[chat_id] = 'en'
    else:
        user_langs[chat_id] = 'kh'
        
    lang = user_langs[chat_id]
    
    try:
        bot.delete_message(chat_id, call.message.message_id)
    except:
        pass
    
    markup = ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    markup.add(
        KeyboardButton(lang_data[lang]['btn_account']),
        KeyboardButton(lang_data[lang]['btn_store']),
        KeyboardButton(lang_data[lang]['btn_deposit']),
        KeyboardButton(lang_data[lang]['btn_admin']),
        KeyboardButton(lang_data[lang]['btn_guide']),
        KeyboardButton(lang_data[lang]['btn_history'])
    )
    
    bot.send_message(chat_id, lang_data[lang]['welcome'], reply_markup=markup)

@bot.message_handler(func=lambda message: True)
def handle_text(message):
    chat_id = message.chat.id
    lang = user_langs.get(chat_id, 'kh')
    text = message.text
    
    if text in [lang_data['kh']['btn_store'], lang_data['en']['btn_store']]:
        bot.send_message(chat_id, lang_data[lang]['msg_store'])
        
    # កន្លែងរៀបចំទម្រង់ គណនី (Account)
    elif text in [lang_data['kh']['btn_account'], lang_data['en']['btn_account']]:
        user_info = message.from_user
        raw_username = user_info.username
        
        # បើគាត់អត់មានដាក់ Username ក្នុង Telegram ទេ វានឹងលោតពាក្យថា None
        display_username = f"@{raw_username}" if raw_username else "មិនមាន (None)"
        
        # ពិនិត្យមើល Username ដើម្បីផ្តល់ Rank (Admin VIP)
        if raw_username and raw_username.lower() == "dumyy_ji2":
            rank = lang_data[lang]['rank_admin']
        else:
            rank = lang_data[lang]['rank_normal']
            
        balance = "0.00 $" # លុយ (អាចទាញពី Database បាននៅពេលក្រោយ)
        
        # បញ្ចូលទិន្នន័យទៅក្នុងទម្រង់ដែលបានរៀបចំទុក
        reply_msg = lang_data[lang]['acc_template'].format(
            username=display_username,
            id=user_info.id,
            balance=balance,
            rank=rank
        )
        # ប្រើ parse_mode='HTML' ដើម្បីឱ្យអក្សរដិតស្អាត និង ID ងាយស្រួល Copy
        bot.send_message(chat_id, reply_msg, parse_mode='HTML')
        
    elif text in [lang_data['kh']['btn_deposit'], lang_data['en']['btn_deposit']]:
        bot.send_message(chat_id, lang_data[lang]['msg_prepare'])
    elif text in [lang_data['kh']['btn_admin'], lang_data['en']['btn_admin']]:
        bot.send_message(chat_id, lang_data[lang]['msg_admin'])
    elif text in [lang_data['kh']['btn_guide'], lang_data['en']['btn_guide']]:
        bot.send_message(chat_id, lang_data[lang]['msg_guide'])
    elif text in [lang_data['kh']['btn_history'], lang_data['en']['btn_history']]:
        bot.send_message(chat_id, lang_data[lang]['msg_history'])

