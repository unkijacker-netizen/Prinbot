import telebot
from telebot.types import ReplyKeyboardMarkup, KeyboardButton, InlineKeyboardMarkup, InlineKeyboardButton

# បញ្ចូល Bot Token របស់អ្នកនៅទីនេះ
BOT_TOKEN = "ដាក់_TOKEN_របស់អ្នកនៅទីនេះ"
bot = telebot.TeleBot(BOT_TOKEN)

# ទុកកំណត់ត្រាភាសារបស់អ្នកប្រើប្រាស់ម្នាក់ៗ (Default: 'en')
user_lang = {}

# ទិន្នន័យអត្ថបទសម្រាប់ភាសាខ្មែរ និងអង់គ្លេស
texts = {
    'en': {
        'welcome': "👋 Welcome to our bot! Please choose an option below:",
        'account': "👤 Account",
        'store': "🛒 Store",
        'add_fund': "💳 Add Fund",
        'support': "🎧 Support",
        'change_lang': "🌐 Change Language",
        'lang_prompt': "Please select your language:",
        'reply': "You clicked: "
    },
    'km': {
        'welcome': "👋 សូមស្វាគមន៍មកកាន់ Bot របស់យើង! សូមជ្រើសរើសជម្រើសខាងក្រោម៖",
        'account': "👤 គណនី",
        'store': "🛒 ហាង",
        'add_fund': "💳 បញ្ចូលប្រាក់",
        'support': "🎧 ជំនួយ",
        'change_lang': "🌐 ប្តូរភាសា",
        'lang_prompt': "សូមជ្រើសរើសភាសារបស់អ្នក (Select Language):",
        'reply': "អ្នកបានចុច៖ "
    }
}

# មុខងារបង្កើត Main Menu Buttons
def get_main_menu(lang):
    markup = ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    btn1 = KeyboardButton(texts[lang]['account'])
    btn2 = KeyboardButton(texts[lang]['store'])
    btn3 = KeyboardButton(texts[lang]['add_fund'])
    btn4 = KeyboardButton(texts[lang]['support'])
    btn5 = KeyboardButton(texts[lang]['change_lang'])
    markup.add(btn1, btn2)
    markup.add(btn3, btn4)
    markup.add(btn5)
    return markup

# មុខងារបង្កើត Button ជ្រើសរើសភាសា (Inline)
def get_language_menu():
    markup = InlineKeyboardMarkup()
    btn_km = InlineKeyboardButton("🇰🇭 ភាសាខ្មែរ", callback_data="lang_km")
    btn_en = InlineKeyboardButton("🇬🇧 English", callback_data="lang_en")
    markup.add(btn_km, btn_en)
    return markup

# ចាប់យក Command /start
@bot.message_handler(commands=['start'])
def send_welcome(message):
    user_id = message.chat.id
    # បង្ហាញជម្រើសភាសាពេលចូលដំបូង
    bot.send_message(user_id, "🌐 Please select your language / សូមជ្រើសរើសភាសា៖", reply_markup=get_language_menu())

# ចាប់យកការចុចលើ Button ប្តូរភាសា (Inline Buttons)
@bot.callback_query_handler(func=lambda call: call.data in ['lang_km', 'lang_en'])
def handle_language_selection(call):
    user_id = call.message.chat.id
    if call.data == 'lang_km':
        user_lang[user_id] = 'km'
        bot.answer_callback_query(call.id, "អ្នកបានជ្រើសរើសភាសាខ្មែរ")
    else:
        user_lang[user_id] = 'en'
        bot.answer_callback_query(call.id, "You selected English")
    
    lang = user_lang[user_id]
    # លុបសារជ្រើសរើសភាសាចាស់ចោល និងផ្ញើ Main Menu ថ្មី
    bot.delete_message(user_id, call.message.message_id)
    bot.send_message(user_id, texts[lang]['welcome'], reply_markup=get_main_menu(lang))

# ចាប់យកការចុចលើ Main Menu Buttons
@bot.message_handler(func=lambda message: True)
def handle_menu_clicks(message):
    user_id = message.chat.id
    lang = user_lang.get(user_id, 'en') # យកភាសា English ជាគោលបើមិនទាន់បានរើស
    text = message.text
    
    # ពិនិត្យមើលថាតើគាត់ចុចប៊ូតុងមួយណា
    if text in [texts['en']['change_lang'], texts['km']['change_lang']]:
        bot.send_message(user_id, texts[lang]['lang_prompt'], reply_markup=get_language_menu())
    
    elif text in [texts['en']['account'], texts['km']['account']]:
        bot.send_message(user_id, f"{texts[lang]['reply']} <b>{text}</b>\n\n<i>ទិន្នន័យគណនីរបស់អ្នកនឹងបង្ហាញនៅទីនេះ...</i>", parse_mode='HTML')
        
    elif text in [texts['en']['store'], texts['km']['store']]:
        bot.send_message(user_id, f"{texts[lang]['reply']} <b>{text}</b>\n\n<i>ទំនិញក្នុងហាងនឹងបង្ហាញនៅទីនេះ...</i>", parse_mode='HTML')
        
    elif text in [texts['en']['add_fund'], texts['km']['add_fund']]:
        bot.send_message(user_id, f"{texts[lang]['reply']} <b>{text}</b>\n\n<i>សូមជ្រើសរើសវិធីសាស្ត្របង់ប្រាក់...</i>", parse_mode='HTML')
        
    elif text in [texts['en']['support'], texts['km']['support']]:
        bot.send_message(user_id, f"{texts[lang]['reply']} <b>{text}</b>\n\n<i>ទាក់ទងមកកាន់ Admin តាមរយៈ @YourAdminUsername...</i>", parse_mode='HTML')
        
    else:
        # បើគាត់វាយអក្សរផ្សេង
        bot.send_message(user_id, texts[lang]['welcome'], reply_markup=get_main_menu(lang))

# ដំណើរការ Bot កុំឲ្យឈប់
if __name__ == "__main__":
    print("Bot is running...")
    bot.infinity_polling()
