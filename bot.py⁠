import os
import telebot
from telebot import types

# ទាញយក Token ពី Environment Variables របស់ Railway
BOT_TOKEN = os.environ.get('BOT_TOKEN')
bot = telebot.TeleBot(BOT_TOKEN)

# ពេលចុច /start
@bot.message_handler(commands=['start'])
def send_welcome(message):
    # បង្កើតប៊ូតុងខាងក្រោម (Reply Keyboard)
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    btn_services = types.KeyboardButton('🛍️ទិញសេវាកម្ម')
    btn_account = types.KeyboardButton('👨🏻‍💻គណនី')
    markup.add(btn_services, btn_account)
    
    bot.send_message(
        message.chat.id, 
        "សួស្តី! សូមស្វាគមន៍មកកាន់ Bot របស់យើង។ សូមជ្រើសរើសជម្រើសខាងក្រោម៖", 
        reply_markup=markup
    )

# ពេលចុចប៊ូតុង 🛍️ទិញសេវាកម្ម
@bot.message_handler(func=lambda message: message.text == '🛍️ទិញសេវាកម្ម')
def services_menu(message):
    # បង្កើតប៊ូតុងថ្លាៗ (Inline Keyboard) សម្រាប់រើសសេវាកម្ម
    markup = types.InlineKeyboardMarkup(row_width=1)
    btn_ff = types.InlineKeyboardButton("Free Fire", callback_data="service_ff")
    btn_ml = types.InlineKeyboardButton("Mobile legend", callback_data="service_ml")
    btn_maintenance = types.InlineKeyboardButton("🛠️ កំពុងរៀបចំ", callback_data="service_maintenance")
    
    markup.add(btn_ff, btn_ml, btn_maintenance)
    
    bot.send_message(
        message.chat.id, 
        "សូមជ្រើសរើសសេវាកម្មដែលអ្នកចង់ទិញ៖", 
        reply_markup=markup
    )

# ពេលចុចប៊ូតុង 👨🏻‍💻គណនី
@bot.message_handler(func=lambda message: message.text == '👨🏻‍💻គណនី')
def account_info(message):
    user = message.from_user
    
    # ទាញយកព័ត៌មាន User
    username = f"@{user.username}" if user.username else "មិនមាន (None)"
    user_id = user.id
    
    # ទិន្នន័យបណ្តោះអាសន្នសម្រាប់ Rank និង Balance
    rank = "សមាជិកថ្មី"
    balance = "$0.00"
    
    text = (
        f"👨🏻‍💻 ព័ត៌មានគណនីរបស់អ្នក៖\n\n"
        f"👤 Telegram username: {username}\n"
        f"🆔 ID: {user_id}\n"
        f"🏆 Rank: {rank}\n"
        f"💰 Balance: {balance}"
    )
    
    bot.send_message(message.chat.id, text)

# ដំណើរការពេលគេចុចលើប៊ូតុងថ្លាៗ (Inline Buttons) នៃសេវាកម្ម
@bot.callback_query_handler(func=lambda call: True)
def handle_query(call):
    # មិនថាគេចុចប៊ូតុងមួយណាទេ (Free Fire, Mobile Legend, ឫ កំពុងរៀបចំ) វាលោតសារនេះ
    bot.send_message(call.message.chat.id, "🛠️ ប្រព័ន្ធ កំពុងរៀបចំ៖ 🙏🏻🤍")
    bot.answer_callback_query(call.id)

# ឲ្យ Bot ដំណើរការរហូត
print("Bot is starting...")
bot.infinity_polling()
